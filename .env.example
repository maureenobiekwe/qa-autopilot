# Copy this file to .env (never commit .env; it is already in .gitignore).
#   Windows PowerShell:  Copy-Item .env.example .env
#   Mac/Linux Terminal:  cp .env.example .env
# Real environment variables override anything here. Blank values are ignored.

# Optional. Without it the framework runs on offline heuristics.
ANTHROPIC_API_KEY=
QA_MODEL=claude-sonnet-5-5

# Test account for the app under test. Overrides config.json.
QA_USERNAME=
QA_PASSWORD=
